# Document Compliance & Multilingual Validation System — development template
APP_NAME=Document Compliance & Multilingual Validation System
APP_VERSION=1.0.0
VITE_APP_VERSION=1.0.0
APP_ENV=development
APP_TIMEZONE=Asia/Makassar
BACKEND_DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

POSTGRES_DB=document_compliance
POSTGRES_USER=document_compliance
POSTGRES_PASSWORD=REPLACE_ME_LOCAL_ONLY
DATABASE_NAME=document_compliance
DATABASE_USER=document_compliance
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=120000
DB_CONNECT_TIMEOUT_SECONDS=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=100
REDIS_KEY_PREFIX=document-compliance:development
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
SECRET_PROVIDER=environment
AZURE_KEY_VAULT_URL=

BACKEND_CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test
TRUSTED_PROXY_IPS=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_CERTIFICATE_PATH=
MICROSOFT_CLIENT_CERTIFICATE_PASSWORD=
MICROSOFT_GRAPH_AUTH_MODE=client_secret
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_TIMEOUT_SECONDS=60
MICROSOFT_GRAPH_MAX_RETRIES=5
MICROSOFT_GRAPH_RETRY_BASE_SECONDS=2
MICROSOFT_GRAPH_RETRY_MAX_SECONDS=120
MICROSOFT_GRAPH_TOKEN_CACHE_TTL_SECONDS=3000

SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=
SHAREPOINT_ROOT_FOLDER_PATH=DocumentCompliance
SHAREPOINT_SIMPLE_UPLOAD_MAX_MB=4
SHAREPOINT_UPLOAD_CHUNK_SIZE_MB=10
SHAREPOINT_UPLOAD_SESSION_EXPIRY_BUFFER_MINUTES=10
SHAREPOINT_UPLOAD_MAX_FILE_SIZE_MB=10240
SHAREPOINT_SYNC_ENABLED=false
SHAREPOINT_SYNC_MODE=MANUAL
SHAREPOINT_SYNC_INTERVAL_MINUTES=15
SHAREPOINT_DELTA_SYNC_ENABLED=true
SHAREPOINT_WEBHOOK_ENABLED=false
SHAREPOINT_WEBHOOK_NOTIFICATION_URL=
SHAREPOINT_WEBHOOK_CLIENT_STATE=
SHAREPOINT_WEBHOOK_RENEWAL_HOURS=24
SHAREPOINT_WORKER_CONCURRENCY=4

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SENDER_USER_ID=
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_EMAIL_MAX_RECIPIENTS=100
NOTIFICATION_TEAMS_ENABLED=false
NOTIFICATION_TEAMS_MODE=WORKFLOW_WEBHOOK
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_CONNECTION_TEST_PER_MINUTE=5

LOG_FORMAT=console
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=document-compliance-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.10

MALWARE_SCANNING_ENABLED=false
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=120
MALWARE_SCANNER_FAILURE_POLICY=FAIL_CLOSED

CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
SHAREPOINT_QUEUE_NAME=sharepoint
NOTIFICATION_QUEUE_NAME=notifications
MAINTENANCE_QUEUE_NAME=maintenance

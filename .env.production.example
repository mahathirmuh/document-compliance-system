# Copy to a protected .env.production outside source control.
APP_NAME=Document Compliance & Multilingual Validation System
APP_VERSION=1.0.0
VITE_APP_VERSION=1.0.0
APP_ENV=production
APP_TIMEZONE=Asia/Makassar
BACKEND_DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_APP_URL=https://documents.example.com
API_BASE_URL=https://documents.example.com/api
LOG_LEVEL=INFO
LOG_FORMAT=json

POSTGRES_DB=document_compliance
POSTGRES_USER=document_compliance
POSTGRES_PASSWORD=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=120000
DB_CONNECT_TIMEOUT_SECONDS=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required: use a generated secret and repeat it in both authenticated URLs below.
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=100
REDIS_KEY_PREFIX=document-compliance:production
# Required format: redis://:<url-encoded-password>@redis:6379/0
CELERY_BROKER_URL=
# Required format: redis://:<url-encoded-password>@redis:6379/1
CELERY_RESULT_BACKEND=

JWT_SECRET_KEY=
# Required: base64-encoded 16, 24, or preferably 32 random bytes.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
SECRET_PROVIDER=environment
AZURE_KEY_VAULT_URL=
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

BACKEND_CORS_ORIGINS=https://documents.example.com
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=documents.example.com,api.documents.example.com
TRUSTED_PROXY_IPS=172.16.0.0/12
FORWARDED_ALLOW_IPS=172.16.0.0/12

MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_CERTIFICATE_PATH=/run/secrets/microsoft-client-certificate.pem
MICROSOFT_CLIENT_CERTIFICATE_PASSWORD=
MICROSOFT_GRAPH_AUTH_MODE=certificate
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_TIMEOUT_SECONDS=60
MICROSOFT_GRAPH_MAX_RETRIES=5
MICROSOFT_GRAPH_RETRY_BASE_SECONDS=2
MICROSOFT_GRAPH_RETRY_MAX_SECONDS=120
MICROSOFT_GRAPH_TOKEN_CACHE_TTL_SECONDS=3000

SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=
SHAREPOINT_ROOT_FOLDER_PATH=DocumentCompliance
SHAREPOINT_SIMPLE_UPLOAD_MAX_MB=4
SHAREPOINT_UPLOAD_CHUNK_SIZE_MB=10
SHAREPOINT_UPLOAD_SESSION_EXPIRY_BUFFER_MINUTES=10
SHAREPOINT_UPLOAD_MAX_FILE_SIZE_MB=10240
SHAREPOINT_SYNC_ENABLED=false
SHAREPOINT_SYNC_MODE=MANUAL
SHAREPOINT_SYNC_INTERVAL_MINUTES=15
SHAREPOINT_DELTA_SYNC_ENABLED=true
SHAREPOINT_WEBHOOK_ENABLED=false
SHAREPOINT_WEBHOOK_NOTIFICATION_URL=
SHAREPOINT_WEBHOOK_CLIENT_STATE=
SHAREPOINT_WEBHOOK_RENEWAL_HOURS=24
SHAREPOINT_WORKER_CONCURRENCY=4

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SENDER_USER_ID=
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_EMAIL_MAX_RECIPIENTS=100
NOTIFICATION_TEAMS_ENABLED=false
NOTIFICATION_TEAMS_MODE=WORKFLOW_WEBHOOK
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_CONNECTION_TEST_PER_MINUTE=5

METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=document-compliance-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.10

MALWARE_SCANNING_ENABLED=true
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=120
MALWARE_SCANNER_FAILURE_POLICY=FAIL_CLOSED

CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
SHAREPOINT_QUEUE_NAME=sharepoint
NOTIFICATION_QUEUE_NAME=notifications
MAINTENANCE_QUEUE_NAME=maintenance

API_WORKERS=4
API_TIMEOUT_SECONDS=120
API_GRACEFUL_TIMEOUT_SECONDS=30
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_CERTIFICATE_PATH=./deploy/secrets/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=./deploy/secrets/tls/privkey.pem

# Application
APP_NAME=Document Compliance API
APP_VERSION=0.7.0
VITE_APP_VERSION=0.7.0
APP_ENV=development
APP_TIMEZONE=Asia/Makassar
BACKEND_DEBUG=false
API_V1_PREFIX=/api/v1

# Published host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Frontend
# Keep the browser-facing API path relative when Vite/nginx proxies the backend.
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
VITE_DOCUMENT_MAX_FILE_SIZE_MB=50
VITE_DOCUMENT_BATCH_MAX_FILES=50
VITE_DOCUMENT_BATCH_MAX_TOTAL_SIZE_MB=500

# PostgreSQL
POSTGRES_DB=document_compliance
POSTGRES_USER=document_compliance
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LOCAL_DATABASE_PASSWORD

# The backend builds an encoded async SQLAlchemy URL from these values.
# Docker Compose overrides this host with the internal "postgres" hostname.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_ECHO=false

# Backend CORS origins, comma-separated without spaces.
BACKEND_CORS_ORIGINS=http://localhost:5173

# JWT authentication
# PLACEHOLDER ONLY: generate a unique cryptographically random value before use.
JWT_SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Login protection
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Phase 2 bootstrap administrator
# Set a unique password before running the seed command. Never commit real values.
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_UNIQUE_PASSWORD_9!

# Phase 5 physical-document storage and upload validation
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
STORAGE_DOCUMENTS_PREFIX=documents/originals
STORAGE_TEMP_PREFIX=documents/temporary
STORAGE_QUARANTINE_PREFIX=documents/quarantine
STORAGE_DELETED_PREFIX=documents/deleted
DOCUMENT_MAX_FILE_SIZE_MB=50
DOCUMENT_BATCH_MAX_FILES=50
DOCUMENT_BATCH_MAX_TOTAL_SIZE_MB=500
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.xlsx
ENABLE_FILE_SIGNATURE_VALIDATION=true
ENABLE_DUPLICATE_FILE_HASH_CHECK=true
ENABLE_FILE_QUARANTINE=true
FILE_DOWNLOAD_CHUNK_SIZE_KB=1024
TEMP_FILE_RETENTION_HOURS=24

# Phase 6 extraction queue and worker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
EXTRACTION_QUEUE_NAME=extraction
EXTRACTION_WORKER_CONCURRENCY=2
EXTRACTION_TASK_TIME_LIMIT_SECONDS=1800
EXTRACTION_TASK_SOFT_TIME_LIMIT_SECONDS=1500
EXTRACTION_MAX_RETRIES=2

# Phase 6 extraction resource limits
EXTRACTION_MAX_FILE_SIZE_MB=50
EXTRACTION_DB_BATCH_SIZE=1000
PDF_MAX_PAGES=5000
PDF_MIN_CHARACTERS_PER_PAGE=20
PDF_SCANNED_PAGE_RATIO_THRESHOLD=0.7
DOCX_MAX_PARAGRAPHS=500000
DOCX_MAX_TABLES=10000
DOCX_MAX_TABLE_CELLS=2000000
XLSX_MAX_WORKSHEETS=200
XLSX_MAX_ROWS_PER_SHEET=200000
XLSX_MAX_CELLS_PER_WORKBOOK=2000000
XLSX_MAX_FORMULAS=500000
EXTRACTION_EXPORT_MAX_BLOCKS=2000000
EXTRACTION_SEARCH_MAX_RESULTS=500

# Phase 7 local OCR provider, queues, and resource limits
OCR_QUEUE_NAME=ocr
LANGUAGE_QUEUE_NAME=language
OCR_WORKER_CONCURRENCY=1
LANGUAGE_WORKER_CONCURRENCY=2
OCR_PROVIDER=paddleocr
OCR_MODEL_ROOT=/app/models/ocr
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
OCR_AUTO_MULTILINGUAL_CHINESE_PASS=true
OCR_AUTO_MULTILINGUAL_CHINESE_PASS_CONFIDENCE_THRESHOLD=0.65
OCR_AUTO_MULTILINGUAL_CHINESE_PASS_MINIMUM_CHARACTERS=20
OCR_RENDER_DPI=300
OCR_RENDER_FORMAT=png
OCR_MAX_RENDER_WIDTH=6000
OCR_MAX_RENDER_HEIGHT=6000
OCR_MAX_PAGES_PER_JOB=500
OCR_MAX_CONCURRENT_JOBS_PER_USER=3
OCR_TASK_TIME_LIMIT_SECONDS=3600
OCR_TASK_SOFT_TIME_LIMIT_SECONDS=3300
OCR_MAX_RETRIES=1
OCR_LOW_CONFIDENCE_THRESHOLD=0.60
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.80
OCR_SKIP_PAGES_WITH_SELECTABLE_TEXT=true
OCR_SELECTABLE_TEXT_MIN_CHARACTERS=50
OCR_TEMP_IMAGE_RETENTION_HOURS=2
OCR_DEFAULT_PREPROCESSING_PROFILE=STANDARD
OCR_LATIN_MODEL_NAME=latin_PP-OCRv5_mobile_rec
OCR_CHINESE_MODEL_NAME=PP-OCRv5_mobile_rec

# Phase 7 local hybrid language detection
LANGUAGE_MODEL_PATH=/app/models/language/lid.176.bin
LANGUAGE_MODEL_URL=https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin
LANGUAGE_MODEL_SHA256=
LANGUAGE_MIN_CHARACTERS=4
LANGUAGE_MIN_ALPHA_CHARACTERS=3
LANGUAGE_SHORT_TEXT_THRESHOLD=20
LANGUAGE_CONFIDENCE_MINIMUM=0.55
LANGUAGE_CONFIDENCE_REVIEW_THRESHOLD=0.75
LANGUAGE_HAN_CHARACTER_RATIO_THRESHOLD=0.20
LANGUAGE_MIXED_SECONDARY_SCORE_THRESHOLD=0.25
LANGUAGE_MIXED_MIN_CHARACTER_RATIO=0.15
LANGUAGE_PRESENCE_MIN_BLOCKS=2
LANGUAGE_PRESENCE_MIN_CHARACTERS=20
LANGUAGE_DETECTION_DB_BATCH_SIZE=1000
LANGUAGE_DETECTION_MAX_BLOCKS=2000000
LANGUAGE_EXPORT_MAX_BLOCKS=2000000
LANGUAGE_TASK_TIME_LIMIT_SECONDS=1800
LANGUAGE_TASK_SOFT_TIME_LIMIT_SECONDS=1500
LANGUAGE_MAX_RETRIES=1

# Phase 7 remains manual by default
AUTO_RUN_OCR_AFTER_EXTRACTION=false
AUTO_RUN_LANGUAGE_DETECTION_AFTER_EXTRACTION=false
AUTO_RUN_LANGUAGE_DETECTION_AFTER_OCR=false

# Phase 3 master-data spreadsheet limits
MASTER_DATA_IMPORT_MAX_ROWS=5000
MASTER_DATA_EXPORT_MAX_ROWS=50000

# Phase 4 Document Register defaults and spreadsheet limits
DEFAULT_COMPANY_CODE=MTI
DOCUMENT_REGISTER_IMPORT_MAX_ROWS=10000
DOCUMENT_REGISTER_EXPORT_MAX_ROWS=100000
DOCUMENT_IMPORT_MAX_FILE_SIZE_MB=25
DOCUMENT_NUMBER_MAX_LENGTH=50
DOCUMENT_TITLE_MAX_LENGTH=500
ARCHIVE_REASON_MAX_LENGTH=1000


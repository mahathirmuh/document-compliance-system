# Application
APP_NAME=Document Compliance & Multilingual Validation System
APP_VERSION=1.0.0
VITE_APP_VERSION=1.0.0
APP_ENV=development
APP_TIMEZONE=Asia/Makassar
BACKEND_DEBUG=false
API_V1_PREFIX=/api/v1

# Published host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Frontend
# Keep the browser-facing API path relative when Vite/nginx proxies the backend.
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
VITE_DOCUMENT_MAX_FILE_SIZE_MB=50
VITE_DOCUMENT_BATCH_MAX_FILES=50
VITE_DOCUMENT_BATCH_MAX_TOTAL_SIZE_MB=500

# PostgreSQL
POSTGRES_DB=document_compliance
POSTGRES_USER=document_compliance
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LOCAL_DATABASE_PASSWORD

# Application database target. DATABASE_PASSWORD falls back to
# POSTGRES_PASSWORD when it is omitted.
DATABASE_NAME=document_compliance
DATABASE_USER=document_compliance
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_ECHO=false

# Backend CORS origins, comma-separated without spaces.
BACKEND_CORS_ORIGINS=http://localhost:5173

# JWT authentication
# PLACEHOLDER ONLY: generate a unique cryptographically random value before use.
JWT_SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Login protection
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Phase 2 bootstrap administrator
# Set a unique password before running the seed command. Never commit real values.
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_UNIQUE_PASSWORD_9!

# Phase 5 physical-document storage and upload validation
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
STORAGE_DOCUMENTS_PREFIX=documents/originals
STORAGE_TEMP_PREFIX=documents/temporary
STORAGE_QUARANTINE_PREFIX=documents/quarantine
STORAGE_DELETED_PREFIX=documents/deleted
DOCUMENT_MAX_FILE_SIZE_MB=50
DOCUMENT_BATCH_MAX_FILES=50
DOCUMENT_BATCH_MAX_TOTAL_SIZE_MB=500
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.xlsx
ENABLE_FILE_SIGNATURE_VALIDATION=true
ENABLE_DUPLICATE_FILE_HASH_CHECK=true
ENABLE_FILE_QUARANTINE=true
FILE_DOWNLOAD_CHUNK_SIZE_KB=1024
TEMP_FILE_RETENTION_HOURS=24

# Phase 6 extraction queue and worker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
EXTRACTION_QUEUE_NAME=extraction
EXTRACTION_WORKER_CONCURRENCY=2
EXTRACTION_TASK_TIME_LIMIT_SECONDS=1800
EXTRACTION_TASK_SOFT_TIME_LIMIT_SECONDS=1500
EXTRACTION_MAX_RETRIES=2

# Phase 6 extraction resource limits
EXTRACTION_MAX_FILE_SIZE_MB=50
EXTRACTION_DB_BATCH_SIZE=1000
PDF_MAX_PAGES=5000
PDF_MIN_CHARACTERS_PER_PAGE=20
PDF_SCANNED_PAGE_RATIO_THRESHOLD=0.7
DOCX_MAX_PARAGRAPHS=500000
DOCX_MAX_TABLES=10000
DOCX_MAX_TABLE_CELLS=2000000
XLSX_MAX_WORKSHEETS=200
XLSX_MAX_ROWS_PER_SHEET=200000
XLSX_MAX_CELLS_PER_WORKBOOK=2000000
XLSX_MAX_FORMULAS=500000
EXTRACTION_EXPORT_MAX_BLOCKS=2000000
EXTRACTION_SEARCH_MAX_RESULTS=500

# Phase 7 local OCR provider, queues, and resource limits
OCR_QUEUE_NAME=ocr
LANGUAGE_QUEUE_NAME=language
OCR_WORKER_CONCURRENCY=1
LANGUAGE_WORKER_CONCURRENCY=2
OCR_PROVIDER=paddleocr
OCR_MODEL_ROOT=/app/models/ocr
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
OCR_AUTO_MULTILINGUAL_CHINESE_PASS=true
OCR_AUTO_MULTILINGUAL_CHINESE_PASS_CONFIDENCE_THRESHOLD=0.65
OCR_AUTO_MULTILINGUAL_CHINESE_PASS_MINIMUM_CHARACTERS=20
OCR_RENDER_DPI=300
OCR_RENDER_FORMAT=png
OCR_MAX_RENDER_WIDTH=6000
OCR_MAX_RENDER_HEIGHT=6000
OCR_MAX_PAGES_PER_JOB=500
OCR_MAX_CONCURRENT_JOBS_PER_USER=3
OCR_TASK_TIME_LIMIT_SECONDS=3600
OCR_TASK_SOFT_TIME_LIMIT_SECONDS=3300
OCR_MAX_RETRIES=1
OCR_LOW_CONFIDENCE_THRESHOLD=0.60
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.80
OCR_SKIP_PAGES_WITH_SELECTABLE_TEXT=true
OCR_SELECTABLE_TEXT_MIN_CHARACTERS=50
OCR_TEMP_IMAGE_RETENTION_HOURS=2
OCR_DEFAULT_PREPROCESSING_PROFILE=STANDARD
OCR_LATIN_MODEL_NAME=latin_PP-OCRv5_mobile_rec
OCR_CHINESE_MODEL_NAME=PP-OCRv5_mobile_rec

# Phase 7 local hybrid language detection
LANGUAGE_MODEL_PATH=/app/models/language/lid.176.bin
LANGUAGE_MODEL_URL=https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin
LANGUAGE_MODEL_SHA256=
LANGUAGE_MIN_CHARACTERS=4
LANGUAGE_MIN_ALPHA_CHARACTERS=3
LANGUAGE_SHORT_TEXT_THRESHOLD=20
LANGUAGE_CONFIDENCE_MINIMUM=0.55
LANGUAGE_CONFIDENCE_REVIEW_THRESHOLD=0.75
LANGUAGE_HAN_CHARACTER_RATIO_THRESHOLD=0.20
LANGUAGE_MIXED_SECONDARY_SCORE_THRESHOLD=0.25
LANGUAGE_MIXED_MIN_CHARACTER_RATIO=0.15
LANGUAGE_PRESENCE_MIN_BLOCKS=2
LANGUAGE_PRESENCE_MIN_CHARACTERS=20
LANGUAGE_DETECTION_DB_BATCH_SIZE=1000
LANGUAGE_DETECTION_MAX_BLOCKS=2000000
LANGUAGE_EXPORT_MAX_BLOCKS=2000000
LANGUAGE_TASK_TIME_LIMIT_SECONDS=1800
LANGUAGE_TASK_SOFT_TIME_LIMIT_SECONDS=1500
LANGUAGE_MAX_RETRIES=1

# Phase 7 remains manual by default
AUTO_RUN_OCR_AFTER_EXTRACTION=false
AUTO_RUN_LANGUAGE_DETECTION_AFTER_EXTRACTION=false
AUTO_RUN_LANGUAGE_DETECTION_AFTER_OCR=false

# Phase 8 multilingual compliance validation
COMPLIANCE_QUEUE_NAME=compliance
COMPLIANCE_WORKER_CONCURRENCY=2
COMPLIANCE_MAX_BLOCKS=2000000
COMPLIANCE_MAX_TRANSLATION_GROUPS=500000
COMPLIANCE_DB_BATCH_SIZE=1000
COMPLIANCE_TASK_TIME_LIMIT_SECONDS=1800
COMPLIANCE_TASK_SOFT_TIME_LIMIT_SECONDS=1500
COMPLIANCE_MAX_RETRIES=1
SECTION_MATCH_MIN_CONFIDENCE=0.80
SECTION_FUZZY_MATCH_THRESHOLD=0.88
SECTION_HEADING_MAX_CHARACTERS=200
SECTION_ALIAS_REGEX_MAX_LENGTH=500
SECTION_ALIAS_REGEX_TIMEOUT_MS=100
TRANSLATION_GROUP_MAX_BLOCK_DISTANCE=3
TRANSLATION_GROUP_MAX_VERTICAL_GAP=120
TRANSLATION_GROUP_MIN_CONFIDENCE=0.65
FINDING_EXPORT_MAX_ROWS=200000
COMPLIANCE_EXPORT_MAX_ROWS=200000
FINDING_BULK_ACTION_MAX_ITEMS=100

# Phase 9 local quality intelligence and advanced reporting
SIMILARITY_QUEUE_NAME=similarity
GLOSSARY_QUEUE_NAME=glossary
REVISION_COMPARISON_QUEUE_NAME=revision-comparison
REPORTING_QUEUE_NAME=reporting
SIMILARITY_WORKER_CONCURRENCY=1
GLOSSARY_WORKER_CONCURRENCY=2
REVISION_WORKER_CONCURRENCY=2
REPORTING_WORKER_CONCURRENCY=1
SIMILARITY_PROVIDER=sentence_transformer
SIMILARITY_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_MODEL_PATH=/app/models/similarity
SIMILARITY_DEVICE=cpu
SIMILARITY_BATCH_SIZE=32
SIMILARITY_MAX_SEQUENCE_LENGTH=512
SIMILARITY_NORMALIZE_EMBEDDINGS=true
SIMILARITY_SKIP_CODE_LIKE_TEXT=true
SIMILARITY_SKIP_NUMERIC_ONLY_TEXT=true
SIMILARITY_HIGH_THRESHOLD=0.85
SIMILARITY_ACCEPTABLE_THRESHOLD=0.72
SIMILARITY_REVIEW_THRESHOLD=0.58
SIMILARITY_CRITICAL_LOW_THRESHOLD=0.35
SIMILARITY_MIN_CHARACTERS_PER_TEXT=10
SIMILARITY_MIN_GROUP_CONFIDENCE=0.65
SIMILARITY_TEXT_MAX_CHARACTERS=12000
SIMILARITY_SNIPPET_MAX_CHARACTERS=500
SIMILARITY_CHUNK_MAX_CHARACTERS=1500
SIMILARITY_CHUNK_OVERLAP_CHARACTERS=150
SIMILARITY_MAX_CHUNKS_PER_TEXT=50
SIMILARITY_TASK_TIME_LIMIT_SECONDS=3600
SIMILARITY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
SIMILARITY_MAX_RETRIES=1
SIMILARITY_DB_BATCH_SIZE=500
GLOSSARY_TERM_MAX_LENGTH=500
GLOSSARY_REGEX_MAX_LENGTH=500
GLOSSARY_REGEX_TIMEOUT_MS=100
GLOSSARY_IMPORT_MAX_ROWS=100000
GLOSSARY_VALIDATION_MAX_BLOCKS=2000000
GLOSSARY_DB_BATCH_SIZE=1000
GLOSSARY_TASK_TIME_LIMIT_SECONDS=3600
GLOSSARY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
GLOSSARY_MAX_RETRIES=1
REVISION_COMPARISON_MAX_BLOCKS=3000000
REVISION_COMPARISON_MAX_CHANGES=1000000
REVISION_COMPARISON_TASK_TIME_LIMIT_SECONDS=3600
REVISION_COMPARISON_TASK_SOFT_TIME_LIMIT_SECONDS=3300
REVISION_COMPARISON_DB_BATCH_SIZE=1000
REVISION_COMPARISON_MAX_RETRIES=1
REVISION_ALIGNMENT_FUZZY_THRESHOLD=0.58
REPORT_EXPORT_MAX_ROWS=500000
REPORT_SNAPSHOT_RETENTION_DAYS=30
REPORT_TASK_TIME_LIMIT_SECONDS=3600
REPORTING_TASK_SOFT_TIME_LIMIT_SECONDS=3300
REPORTING_MAX_RETRIES=1
REPORT_PDF_MAX_TABLE_ROWS=5000
REPORT_XLSX_MAX_ROWS_PER_SHEET=1000000
REPORT_CHART_MAX_CATEGORIES=50
REPORT_TEXT_SNIPPET_MAX_CHARACTERS=500
REPORT_INCLUDE_FULL_TEXT=false

# Phase 3 master-data spreadsheet limits
MASTER_DATA_IMPORT_MAX_ROWS=5000
MASTER_DATA_EXPORT_MAX_ROWS=50000

# Phase 4 Document Register defaults and spreadsheet limits
DEFAULT_COMPANY_CODE=MTI
DOCUMENT_REGISTER_IMPORT_MAX_ROWS=10000
DOCUMENT_REGISTER_EXPORT_MAX_ROWS=100000
DOCUMENT_IMPORT_MAX_FILE_SIZE_MB=25
DOCUMENT_NUMBER_MAX_LENGTH=50
DOCUMENT_TITLE_MAX_LENGTH=500
ARCHIVE_REASON_MAX_LENGTH=1000

# Phase 10 Microsoft Graph and SharePoint Online
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_CERTIFICATE_PATH=
MICROSOFT_CLIENT_CERTIFICATE_PASSWORD=
MICROSOFT_GRAPH_AUTH_MODE=client_secret
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_TIMEOUT_SECONDS=60
MICROSOFT_GRAPH_MAX_RETRIES=5
MICROSOFT_GRAPH_RETRY_BASE_SECONDS=2
MICROSOFT_GRAPH_RETRY_MAX_SECONDS=120
MICROSOFT_GRAPH_TOKEN_CACHE_TTL_SECONDS=3000

SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=
SHAREPOINT_ROOT_FOLDER_PATH=DocumentCompliance
SHAREPOINT_SIMPLE_UPLOAD_MAX_MB=4
SHAREPOINT_UPLOAD_CHUNK_SIZE_MB=10
SHAREPOINT_UPLOAD_SESSION_EXPIRY_BUFFER_MINUTES=10
SHAREPOINT_UPLOAD_MAX_FILE_SIZE_MB=10240
SHAREPOINT_SYNC_ENABLED=false
SHAREPOINT_SYNC_MODE=MANUAL
SHAREPOINT_SYNC_INTERVAL_MINUTES=15
SHAREPOINT_DELTA_SYNC_ENABLED=true
SHAREPOINT_WEBHOOK_ENABLED=false
SHAREPOINT_WEBHOOK_NOTIFICATION_URL=
SHAREPOINT_WEBHOOK_CLIENT_STATE=
SHAREPOINT_WEBHOOK_RENEWAL_HOURS=24
SHAREPOINT_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_CONCURRENCY=2
MAINTENANCE_WORKER_CONCURRENCY=1
SHAREPOINT_QUEUE_NAME=sharepoint
NOTIFICATION_QUEUE_NAME=notifications
MAINTENANCE_QUEUE_NAME=maintenance

# Phase 10 notification adapters (all remote channels disabled by default)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SENDER_USER_ID=
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_EMAIL_MAX_RECIPIENTS=100
NOTIFICATION_TEAMS_ENABLED=false
NOTIFICATION_TEAMS_MODE=WORKFLOW_WEBHOOK
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Phase 10 production security
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
SECRET_PROVIDER=environment
AZURE_KEY_VAULT_URL=
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test
TRUSTED_PROXY_IPS=
FORWARDED_ALLOW_IPS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_CONNECTION_TEST_PER_MINUTE=5

# Phase 10 database, Redis, Celery, logging, and telemetry hardening
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=120000
DB_CONNECT_TIMEOUT_SECONDS=10
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=100
REDIS_KEY_PREFIX=document-compliance:development
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
SHAREPOINT_TASK_TIME_LIMIT_SECONDS=7200
SHAREPOINT_TASK_SOFT_TIME_LIMIT_SECONDS=6900
SHAREPOINT_MAX_RETRIES=3
NOTIFICATION_TASK_TIME_LIMIT_SECONDS=600
NOTIFICATION_TASK_SOFT_TIME_LIMIT_SECONDS=540
NOTIFICATION_MAX_RETRIES=3
MAINTENANCE_TASK_TIME_LIMIT_SECONDS=3600
MAINTENANCE_TASK_SOFT_TIME_LIMIT_SECONDS=3300
LOG_FORMAT=console
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=document-compliance-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.10

# Phase 10 malware scanning; production recommendation is enabled/fail-closed.
MALWARE_SCANNING_ENABLED=false
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=120
MALWARE_SCANNER_FAILURE_POLICY=FAIL_CLOSED


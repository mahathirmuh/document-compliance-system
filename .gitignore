# Environment and secrets
.env
.env.*
!.env.example
!.env.development.example
!.env.production.example

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime storage: keep directory structure, not uploaded/generated files
storage/uploads/*
!storage/uploads/.gitkeep
storage/extracted/*
!storage/extracted/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/temporary/*
!storage/temporary/.gitkeep
storage/documents/originals/*
!storage/documents/originals/.gitkeep
storage/documents/temporary/*
!storage/documents/temporary/.gitkeep
storage/documents/quarantine/*
!storage/documents/quarantine/.gitkeep
storage/documents/deleted/*
!storage/documents/deleted/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/celerybeat/*

# Local OCR and language models: keep layout, never commit model binaries
models/ocr/*
!models/ocr/.gitkeep
models/language/*
!models/language/.gitkeep
models/similarity/*
!models/similarity/.gitkeep

# Local databases, logs, and temporary files
*.db
*.sqlite
*.sqlite3
*.log
/logs/
tmp/
temp/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Docker overrides and local tooling
docker-compose.override.yml
.docker/

# Production secrets and generated backups
deploy/secrets/*
!deploy/secrets/empty.pem
!deploy/secrets/.gitkeep
backups/
*.dump
*.sha256
